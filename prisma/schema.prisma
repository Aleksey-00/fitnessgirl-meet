generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         Role           @default(user)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscriptions Subscription[]
  paymentClaims PaymentClaim[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt  DateTime           @default(now())
  expiresAt DateTime
  status    SubscriptionStatus @default(active)
  createdAt DateTime           @default(now())

  @@index([userId, status])
}

model PaymentClaim {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  note      String?
  status    ClaimStatus @default(pending)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
}

model Profile {
  id                   String    @id @default(cuid())
  vkId                 BigInt    @unique
  displayName          String
  age                  Int?
  city                 String    @default("Москва")
  photoUrl             String?
  photoHash            String?
  photoEstimatedAge    Int?
  photoAgeConfidence   Float?
  photoAgeStatus       String? // ok | underage | unclear | male | error | pending
  photoAgeCheckedAt    DateTime?
  photoGender          String? // female | male | unknown
  photoGenderConfidence Float?
  score                Float     @default(0)
  signals              Json?
  isHidden             Boolean   @default(false)
  fetchedAt            DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([isHidden, score])
  @@index([photoHash])
  @@index([photoAgeStatus])
}

model OptOutRequest {
  id          String    @id @default(cuid())
  vkId        BigInt?
  url         String?
  contact     String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}
