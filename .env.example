DATABASE_URL=postgresql://fitnessgirl:CHANGE_ME_STRONG_PASSWORD@db:5432/fitnessgirl?schema=public
POSTGRES_USER=fitnessgirl
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fitnessgirl
# On Render: only DATABASE_URL is provided (from Blueprint). POSTGRES_* not needed.

NUXT_PUBLIC_SITE_URL=https://your-domain.com
NUXT_PUBLIC_OG_IMAGE=https://your-domain.com/og.jpg
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_YANDEX_VERIFICATION=
# Caddy site address (domain only, no scheme) — optional helper for Caddyfile
# SITE_HOST=your-domain.com

# Session cookie seal (min 32 characters, required in production)
NUXT_SESSION_PASSWORD=replace-with-openssl-rand-hex-32-or-longer

# VK API user/service token with users.search access
VK_ACCESS_TOKEN=

# Admin account email (promoted on register / login)
ADMIN_EMAIL=admin@example.com

# Manual card / SBP payment details shown on /subscribe
PAYMENT_CARD=2200XXXXXXXXXXXX
PAYMENT_PHONE=+79001234567
PAYMENT_HOLDER=IVAN I.
SUBSCRIPTION_PRICE_RUB=990
SUBSCRIPTION_DAYS=30

# Telegram: notify + approve payment claims (webhook secret REQUIRED in production)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret

# Set to 1 only briefly after deploy to migrate old password hashes, then remove
# ALLOW_LEGACY_LOGIN=1

# Indexer defaults
VK_CITY_ID=1
VK_AGE_FROM=18
VK_AGE_TO=35
VK_SCORE_THRESHOLD=2
VK_DAILY_LIMIT=100
VK_REQUEST_DELAY_MS=1200
VK_INDEX_LIMIT=5000
PHOTO_DEDUP_THRESHOLD=10

# Local face analyzer (CLI / tools image only)
PHOTO_AGE_CHECK_LIMIT=200
PHOTO_AGE_CHECK_DELAY_MS=50
PHOTO_MIN_APPARENT_AGE=23
