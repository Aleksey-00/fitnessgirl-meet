[Unit]
Description=Fitnessgirl Meet — schedule home daily VK index (both sexes)

[Timer]
# Once per calendar day at local midnight (Europe/Moscow on this host).
# Persistent=true: if the PC was asleep/off at 00:00, run once after it wakes.
OnCalendar=*-*-* 00:00:00
Persistent=true
AccuracySec=1min
RandomizedDelaySec=0
Unit=fg-indexer-daily.service

[Install]
WantedBy=timers.target
