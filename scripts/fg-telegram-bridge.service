[Unit]
Description=Fitnessgirl Meet — home Telegram bridge (notify + approve)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/c/projects/fitnessgirl-meet
ExecStartPre=/bin/bash -c 'until docker info >/dev/null 2>&1; do sleep 2; done'
# Do not sed -i the live script here (corrupts a concurrent bash). CRLF is normalized at install.
ExecStart=/bin/bash /mnt/c/projects/fitnessgirl-meet/scripts/run-home-telegram.sh
Restart=always
RestartSec=5
TimeoutStartSec=300
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
Environment=FG_SSH_KEY=/home/aazor/.ssh/id_rsa
Environment=FG_VPS=root@134.0.113.50
Environment=HOME=/home/aazor
Environment=USER=aazor
Environment=XDG_RUNTIME_DIR=/run/user/1000
StandardOutput=append:/home/aazor/fg-logs/telegram-bridge.log
StandardError=append:/home/aazor/fg-logs/telegram-bridge.log

[Install]
WantedBy=default.target
